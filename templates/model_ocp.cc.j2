#include "model_ocp.hh"

#include <algorithm>
#include <sstream>

namespace {
std::runtime_error acados_error(const char* operation, int status) {
    std::ostringstream message;
    message << operation << " failed with acados status " << status;
    return std::runtime_error(message.str());
}
}  // namespace

using Vector = ModelOcp::Vector;
using VectorArray = ModelOcp::VectorArray;

Vector ModelOcp::make_vector(std::size_t size, double value) {
{% if vector_type == "eigen" %}
    return Vector::Constant(static_cast<Eigen::Index>(size), value);
{% else %}
    return Vector(size, value);
{% endif %}
}

ModelOcp::ModelOcp() {
    acados_ocp_capsule_ = {{model_name | lower}}_acados_create_capsule();
    if (acados_ocp_capsule_ == nullptr) {
        throw std::runtime_error("Failed to allocate the acados OCP capsule");
    }

    status_ = {{model_name | lower}}_acados_create(acados_ocp_capsule_);
    if (status_ != 0) {
        {{model_name | lower}}_acados_free_capsule(acados_ocp_capsule_);
        acados_ocp_capsule_ = nullptr;
        throw acados_error("{{model_name | lower}}_acados_create", status_);
    }

    nlp_config_ = {{model_name | lower}}_acados_get_nlp_config(acados_ocp_capsule_);
    nlp_dims_ = {{model_name | lower}}_acados_get_nlp_dims(acados_ocp_capsule_);
    nlp_in_ = {{model_name | lower}}_acados_get_nlp_in(acados_ocp_capsule_);
    nlp_out_ = {{model_name | lower}}_acados_get_nlp_out(acados_ocp_capsule_);
    nlp_solver_ = {{model_name | lower}}_acados_get_nlp_solver(acados_ocp_capsule_);
    nlp_opts_ = {{model_name | lower}}_acados_get_nlp_opts(acados_ocp_capsule_);
}

void ModelOcp::require_size(const Vector& value,
                            std::size_t expected,
                            const char* name) {
    if (value.size() != expected) {
        throw std::invalid_argument(std::string(name) + " must contain " +
                                    std::to_string(expected) + " elements, got " +
                                    std::to_string(value.size()));
    }
}

void ModelOcp::require_stage(int stage, bool terminal_allowed) const {
    const int last = terminal_allowed ? N_ : N_ - 1;
    if (stage < 0 || stage > last) {
        throw std::out_of_range("stage must be in [0, " +
                                std::to_string(last) + "]");
    }
}

std::size_t ModelOcp::reference_size(int stage) const {
    require_stage(stage, true);
    if (stage == 0) return ny0;
    if (stage == N_) return ny_terminal;
    return ny;
}

void ModelOcp::set_x0(const Vector& x0) {
    require_size(x0, nbx0, "x0");
    ocp_nlp_constraints_model_set(
        nlp_config_, nlp_dims_, nlp_in_, nlp_out_, 0, "lbx",
        const_cast<double*>(x0.data()));
    ocp_nlp_constraints_model_set(
        nlp_config_, nlp_dims_, nlp_in_, nlp_out_, 0, "ubx",
        const_cast<double*>(x0.data()));
}

void ModelOcp::set_yref(int stage, const Vector& yref) {
    require_size(yref, reference_size(stage), "yref");
    ocp_nlp_cost_model_set(
        nlp_config_, nlp_dims_, nlp_in_, stage, "yref",
        const_cast<double*>(yref.data()));
}

void ModelOcp::set_yref_trajectory(const VectorArray& yrefs) {
    if (yrefs.size() != static_cast<std::size_t>(N_ + 1)) {
        throw std::invalid_argument("yrefs must contain N+1 stage vectors");
    }
    for (int stage = 0; stage <= N_; ++stage) set_yref(stage, yrefs[stage]);
}

void ModelOcp::set_reference(const Vector& xref, const Vector& uref) {
    require_size(xref, nx, "xref");
    require_size(uref, nu, "uref");
    VectorArray xrefs(N_ + 1, xref);
    VectorArray urefs(N_, uref);
    set_reference_trajectory(xrefs, urefs);
}

void ModelOcp::set_reference_trajectory(
    const VectorArray& xrefs,
    const VectorArray& urefs) {
    if (ny0 != nx + nu || ny != nx + nu || ny_terminal != nx) {
        throw std::logic_error(
            "state/control references require stage costs y=[x,u] and terminal cost y_e=x; "
            "use set_yref(stage, yref) for a general cost output");
    }
    if (xrefs.size() != static_cast<std::size_t>(N_ + 1) ||
        urefs.size() != static_cast<std::size_t>(N_)) {
        throw std::invalid_argument("xrefs must have N+1 nodes and urefs must have N nodes");
    }
    for (int stage = 0; stage < N_; ++stage) {
        require_size(xrefs[stage], nx, "state reference");
        require_size(urefs[stage], nu, "control reference");
        Vector yref = make_vector(nx + nu);
        for (int index = 0; index < nx; ++index) {
            yref[index] = xrefs[stage][index];
        }
        for (int index = 0; index < nu; ++index) {
            yref[nx + index] = urefs[stage][index];
        }
        set_yref(stage, yref);
    }
    require_size(xrefs[N_], nx, "terminal state reference");
    set_yref(N_, xrefs[N_]);
}

void ModelOcp::set_parameters(int stage, const Vector& parameters) {
    require_stage(stage, true);
    require_size(parameters, np, "parameters");
    if (np > 0) {
        status_ = {{model_name | lower}}_acados_update_params(
            acados_ocp_capsule_, stage,
            const_cast<double*>(parameters.data()), np);
        if (status_ != 0) throw acados_error("acados_update_params", status_);
    }
}

void ModelOcp::set_parameter_trajectory(const VectorArray& parameters) {
    if (parameters.size() != static_cast<std::size_t>(N_ + 1)) {
        throw std::invalid_argument("parameters must contain N+1 stage vectors");
    }
    for (int stage = 0; stage <= N_; ++stage) {
        set_parameters(stage, parameters[stage]);
    }
}

void ModelOcp::set_global_parameters(const Vector& parameters) {
    require_size(parameters, np_global, "global parameters");
    status_ = {{model_name | lower}}_acados_set_p_global_and_precompute_dependencies(
        acados_ocp_capsule_, const_cast<double*>(parameters.data()), np_global);
    if (status_ != 0) throw acados_error("set global parameters", status_);
}

void ModelOcp::set_rti_phase(int phase) {
    if (phase < 0 || phase > 2) {
        throw std::invalid_argument("RTI phase must be 0 (full), 1 (preparation), or 2 (feedback)");
    }
    ocp_nlp_solver_opts_set(nlp_config_, nlp_opts_, "rti_phase", &phase);
}

void ModelOcp::set_state_guess(int stage, const Vector& state) {
    require_stage(stage, true);
    require_size(state, nx, "state guess");
    ocp_nlp_out_set(
        nlp_config_, nlp_dims_, nlp_out_, nlp_in_, stage, "x",
        const_cast<double*>(state.data()));
}

void ModelOcp::set_control_guess(int stage,
                                 const Vector& control) {
    require_stage(stage, false);
    require_size(control, nu, "control guess");
    ocp_nlp_out_set(
        nlp_config_, nlp_dims_, nlp_out_, nlp_in_, stage, "u",
        const_cast<double*>(control.data()));
}

void ModelOcp::set_state_guess(const VectorArray& states) {
    if (states.size() != static_cast<std::size_t>(N_ + 1)) {
        throw std::invalid_argument("state guess must contain N+1 nodes");
    }
    for (int stage = 0; stage <= N_; ++stage) set_state_guess(stage, states[stage]);
}

void ModelOcp::set_control_guess(const VectorArray& controls) {
    if (controls.size() != static_cast<std::size_t>(N_)) {
        throw std::invalid_argument("control guess must contain N nodes");
    }
    for (int stage = 0; stage < N_; ++stage) set_control_guess(stage, controls[stage]);
}

void ModelOcp::initialize_guess(const Vector& state, const Vector& control) {
    require_size(state, nx, "state guess");
    require_size(control, nu, "control guess");
    for (int stage = 0; stage <= N_; ++stage) set_state_guess(stage, state);
    for (int stage = 0; stage < N_; ++stage) set_control_guess(stage, control);
    has_solution_ = false;
}

void ModelOcp::set_xinit(const Vector& state) {
    require_size(state, nx, "state guess");
    for (int stage = 0; stage <= N_; ++stage) set_state_guess(stage, state);
    has_solution_ = false;
}

void ModelOcp::set_uinit(const Vector& control) {
    require_size(control, nu, "control guess");
    for (int stage = 0; stage < N_; ++stage) set_control_guess(stage, control);
    has_solution_ = false;
}

void ModelOcp::set_yref(const Vector& xref, const Vector& uref) {
    set_reference(xref, uref);
}

void ModelOcp::shift_warm_start() {
    if (!has_solution_) return;
    for (int stage = 0; stage < N_; ++stage) {
        const int source = std::min(stage + 1, N_);
        ocp_nlp_out_set(nlp_config_, nlp_dims_, nlp_out_, nlp_in_, stage,
                        "x", xtraj_.data() + source * nx);
    }
    ocp_nlp_out_set(nlp_config_, nlp_dims_, nlp_out_, nlp_in_, N_,
                    "x", xtraj_.data() + N_ * nx);
    for (int stage = 0; stage < N_; ++stage) {
        const int source = std::min(stage + 1, N_ - 1);
        ocp_nlp_out_set(nlp_config_, nlp_dims_, nlp_out_, nlp_in_, stage,
                        "u", utraj_.data() + source * nu);
    }
}

void ModelOcp::cache_solution() {
    for (int stage = 0; stage <= N_; ++stage) {
        ocp_nlp_out_get(nlp_config_, nlp_dims_, nlp_out_, stage,
                        "x", xtraj_.data() + stage * nx);
    }
    for (int stage = 0; stage < N_; ++stage) {
        ocp_nlp_out_get(nlp_config_, nlp_dims_, nlp_out_, stage,
                        "u", utraj_.data() + stage * nu);
    }
    for (int index = 0; index < nu; ++index) {
        u_opt_[index] = utraj_[index];
    }
    has_solution_ = true;
}

const Vector& ModelOcp::solve() {
    status_ = {{model_name | lower}}_acados_solve(acados_ocp_capsule_);
    ocp_nlp_get(nlp_solver_, "time_tot", &elapsed_time_);
    ocp_nlp_get(nlp_solver_, "sqp_iter", &sqp_iter_);
    ocp_nlp_out_get(nlp_config_, nlp_dims_, nlp_out_, 0,
                    "kkt_norm_inf", &kkt_norm_inf_);
    if (status_ != 0) {
        throw acados_error("{{model_name | lower}}_acados_solve", status_);
    }
    cache_solution();
    return u_opt_;
}

const Vector& ModelOcp::solve(const Vector& x0, const Vector& xref) {
    Vector zero_control = make_vector(nu);
    shift_warm_start();
    set_x0(x0);
    set_reference(xref, zero_control);
    return solve();
}

const Vector& ModelOcp::solve(
    const Vector& x0,
    const VectorArray& xrefs,
    const VectorArray& urefs) {
    shift_warm_start();
    set_x0(x0);
    set_reference_trajectory(xrefs, urefs);
    return solve();
}

ModelOcp::~ModelOcp() noexcept {
    if (acados_ocp_capsule_ == nullptr) return;
    {{model_name | lower}}_acados_free(acados_ocp_capsule_);
    {{model_name | lower}}_acados_free_capsule(acados_ocp_capsule_);
}
