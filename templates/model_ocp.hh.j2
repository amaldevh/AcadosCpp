#pragma once

#include <stdexcept>
#include <string>
#include <vector>

#include "acados_c/ocp_nlp_interface.h"
#include "acados_solver_{{model_name | lower}}.h"

/**
 * Thin, stage-aware C++ interface to the generated acados OCP solver.
 *
 * References are deliberately represented as raw yref vectors.  acados cost
 * outputs need not be [x, u], so a generic wrapper cannot infer their layout.
 * The state/control convenience overload is available for the common
 * NONLINEAR_LS/LINEAR_LS layout [x, u] with terminal output x.
 */
class ModelOcp {
public:
    static constexpr int nx = {{model_name | upper}}_NX;
    static constexpr int nu = {{model_name | upper}}_NU;
    static constexpr int np = {{model_name | upper}}_NP;
    static constexpr int np_global = {{model_name | upper}}_NP_GLOBAL;
    static constexpr int ny0 = {{model_name | upper}}_NY0;
    static constexpr int ny = {{model_name | upper}}_NY;
    static constexpr int ny_terminal = {{model_name | upper}}_NYN;
    static constexpr int nbx0 = {{model_name | upper}}_NBX0;

    ModelOcp();
    ~ModelOcp() noexcept;

    ModelOcp(const ModelOcp&) = delete;
    ModelOcp& operator=(const ModelOcp&) = delete;
    ModelOcp(ModelOcp&&) = delete;
    ModelOcp& operator=(ModelOcp&&) = delete;

    int horizon() const noexcept { return N_; }

    /** Fix the stage-0 constrained state components to the measurement. */
    void set_x0(const std::vector<double>& x0);

    /** Set one cost reference. stage is in [0, N], including the terminal node. */
    void set_yref(int stage, const std::vector<double>& yref);
    void set_yref_trajectory(const std::vector<std::vector<double>>& yrefs);

    /**
     * Convenience reference setters for costs laid out as y=[x,u], y_e=x.
     * The two-argument overload applies a constant setpoint over the horizon.
     */
    void set_reference(const std::vector<double>& xref,
                       const std::vector<double>& uref);
    void set_reference_trajectory(
        const std::vector<std::vector<double>>& xrefs,
        const std::vector<std::vector<double>>& urefs);

    /** Set model parameters for one stage or all N+1 stages. */
    void set_parameters(int stage, const std::vector<double>& parameters);
    void set_parameter_trajectory(
        const std::vector<std::vector<double>>& parameters);
    void set_global_parameters(const std::vector<double>& parameters);

    /** Set 0=full RTI step, 1=preparation, or 2=feedback (SQP_RTI solvers). */
    void set_rti_phase(int phase);

    /** Set initial guesses without changing constraints or references. */
    void set_state_guess(int stage, const std::vector<double>& state);
    void set_control_guess(int stage, const std::vector<double>& control);
    void set_state_guess(const std::vector<std::vector<double>>& states);
    void set_control_guess(const std::vector<std::vector<double>>& controls);
    void initialize_guess(const std::vector<double>& state,
                          const std::vector<double>& control);

    /** Backward-compatible names: initialize every state/control node. */
    void set_xinit(const std::vector<double>& state);
    void set_uinit(const std::vector<double>& control);
    void set_yref(const std::vector<double>& xref,
                  const std::vector<double>& uref);

    /** Shift the most recently solved trajectory by one shooting interval. */
    void shift_warm_start();

    /** Solve and return u at stage 0. Throws when acados reports failure. */
    const std::vector<double>& solve();
    const std::vector<double>& solve(const std::vector<double>& x0,
                                     const std::vector<double>& xref);
    const std::vector<double>& solve(
        const std::vector<double>& x0,
        const std::vector<std::vector<double>>& xrefs,
        const std::vector<std::vector<double>>& urefs);

    const std::vector<double>& state_trajectory() const noexcept { return xtraj_; }
    const std::vector<double>& control_trajectory() const noexcept { return utraj_; }
    const std::vector<double>& control() const noexcept { return u_opt_; }
    int status() const noexcept { return status_; }
    int sqp_iterations() const noexcept { return sqp_iter_; }
    double solve_time() const noexcept { return elapsed_time_; }
    double kkt_norm_inf() const noexcept { return kkt_norm_inf_; }

private:
    static void require_size(const std::vector<double>& value,
                             std::size_t expected,
                             const char* name);
    void require_stage(int stage, bool terminal_allowed) const;
    std::size_t reference_size(int stage) const;
    void cache_solution();

    {{model_name | lower}}_solver_capsule* acados_ocp_capsule_ = nullptr;
    int N_ = {{model_name | upper}}_N;
    int status_ = 0;

    ocp_nlp_config* nlp_config_ = nullptr;
    ocp_nlp_dims* nlp_dims_ = nullptr;
    ocp_nlp_in* nlp_in_ = nullptr;
    ocp_nlp_out* nlp_out_ = nullptr;
    ocp_nlp_solver* nlp_solver_ = nullptr;
    void* nlp_opts_ = nullptr;

    double kkt_norm_inf_ = 0.0;
    double elapsed_time_ = 0.0;
    int sqp_iter_ = 0;
    bool has_solution_ = false;

    std::vector<double> xtraj_ = std::vector<double>(nx * (N_ + 1), 0.0);
    std::vector<double> utraj_ = std::vector<double>(nu * N_, 0.0);
    std::vector<double> u_opt_ = std::vector<double>(nu, 0.0);
};
