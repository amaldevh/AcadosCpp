#include "model_sim.hh"

#include <stdexcept>
#include <string>

using Vector = ModelSim::Vector;

Vector ModelSim::make_vector(std::size_t size, double value) {
{% if vector_type == "eigen" %}
    return Vector::Constant(static_cast<Eigen::Index>(size), value);
{% else %}
    return Vector(size, value);
{% endif %}
}

ModelSim::ModelSim() {
    acados_sim_capsule_ = {{model_name | lower}}_acados_sim_solver_create_capsule();
    if (acados_sim_capsule_ == nullptr) {
        throw std::runtime_error("Failed to allocate the acados simulation capsule");
    }
    status_ = {{model_name | lower}}_acados_sim_create(acados_sim_capsule_);
    if (status_ != 0) {
        {{model_name | lower}}_acados_sim_solver_free_capsule(acados_sim_capsule_);
        acados_sim_capsule_ = nullptr;
        throw std::runtime_error("acados simulation solver creation failed with status " +
                                 std::to_string(status_));
    }
    sim_config_ = {{model_name | lower}}_acados_get_sim_config(acados_sim_capsule_);
    sim_in_ = {{model_name | lower}}_acados_get_sim_in(acados_sim_capsule_);
    sim_out_ = {{model_name | lower}}_acados_get_sim_out(acados_sim_capsule_);
    sim_dims_ = {{model_name | lower}}_acados_get_sim_dims(acados_sim_capsule_);
}

void ModelSim::set_x0(const Vector& state) {
    if (state.size() != nx) {
        throw std::invalid_argument("state must contain " + std::to_string(nx) + " elements");
    }
    x_curr_ = state;
}

const Vector& ModelSim::step(const Vector& control) {
    if (control.size() != nu) {
        throw std::invalid_argument("control must contain " + std::to_string(nu) + " elements");
    }
    u_curr_ = control;
    sim_in_set(sim_config_, sim_dims_, sim_in_, "x", x_curr_.data());
    sim_in_set(sim_config_, sim_dims_, sim_in_, "u", u_curr_.data());
    status_ = {{model_name | lower}}_acados_sim_solve(acados_sim_capsule_);
    if (status_ != 0) {
        throw std::runtime_error("acados simulation solve failed with status " +
                                 std::to_string(status_));
    }
    sim_out_get(sim_config_, sim_dims_, sim_out_, "x", x_curr_.data());
    return x_curr_;
}

void ModelSim::set_dt(double dt) {
    if (dt <= 0.0) throw std::invalid_argument("dt must be positive");
    dt_ = dt;
    sim_in_set(sim_config_, sim_dims_, sim_in_, "T", &dt_);
}

ModelSim::~ModelSim() noexcept {
    if (acados_sim_capsule_ == nullptr) return;
    {{model_name | lower}}_acados_sim_free(acados_sim_capsule_);
    {{model_name | lower}}_acados_sim_solver_free_capsule(acados_sim_capsule_);
}
